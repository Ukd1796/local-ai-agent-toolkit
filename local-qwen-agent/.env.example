OLLAMA_MODEL=qwen3:8b
OLLAMA_HOST=http://localhost:11434
USER_TIMEZONE=Asia/Kolkata
# Workspace folder whose projects are available to filesystem tools.
# Relative paths are based on local-qwen-agent; default is its parent directory.
WORKSPACE_ROOT=..
TAVILY_API_KEY=

MAX_TOOL_ITERATIONS=5
MAX_HISTORY_TURNS=6
MAX_CONTEXT_CHARS=48000
MAX_TOOL_RESULT_CHARS=12000
VERBOSE=false
